{
  "name": "Daylo",
  "short_name": "Daylo",
  "description": "Make every day count. Tasks, notes, goals and focus in one calm, private workspace.",
  "id": "/",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait-primary",
  "background_color": "#F9F4EB",
  "theme_color": "#1F2D26",
