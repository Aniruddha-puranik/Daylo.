  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "/icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/icons/daylo-mark.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    { "name": "New task", "short_name": "Task", "url": "/?action=new-task", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Start focus", "short_name": "Focus", "url": "/?action=focus", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "New note", "short_name": "Note", "url": "/?action=new-note", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
